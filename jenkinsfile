
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Getting project code'
                checkout scm
            }
        }

        stage('Test') {
            steps {
        echo 'Checking Python installation'
        bat '"C:\\Python313\\python.exe" --version'

        echo 'Running Python tests'
        bat '"C:\\Python313\\python.exe" -m unittest'
    }
        }
    }

    post {
        success {
            echo 'CI Pipeline Successful!'
        }

        failure {
            echo 'CI Pipeline Failed!'
        }
    }
}